# 复制本文件为 .env 并填写真实值：copy .env.example .env
# 本模板不含任何真实密钥，可安全提交到 git

DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=your-db-password
DB_HOST=
DB_PORT=

EMAIL_BACKEND=
EMAIL_USE_TLS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-auth-code
DEFAULT_FROM_EMAIL=

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CACHE_LOCATION=

AGENT_LLM_PROVIDER=
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=


OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=
OPENAI_MODEL=

AGENT_EMBED_PROVIDER=
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_EMBED_URL=
QWEN_EMBED_MODEL=

TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
# 可选：Tavily 自定义请求地址（默认官方 https://api.tavily.com，一般无需配置；
# 仅当你的网络需要走代理/镜像时才填写，例如 TAVILY_API_URL=https://your-proxy/tavily）
TAVILY_API_URL=
AGENT_WEB_SEARCH_ENABLED=
AGENT_WEB_SEARCH_MODE=
AGENT_WEB_SEARCH_MAX_RESULTS=
AGENT_WEB_SEARCH_TOPIC=
AGENT_WEB_SEARCH_INCLUDE_RAW_CONTENT=
AGENT_WEB_SEARCH_SEARCH_DEPTH=

LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=

AGENT_CHUNK_SIZE=
AGENT_CHUNK_OVERLAP=
AGENT_TOP_K=

# 向量存储：auto（检测到 milvus 即启用）/ milvus / none
AGENT_VECTOR_STORE=
# Milvus 服务地址（必填；本地 Docker 例：http://127.0.0.1:19530；
# 全容器化部署用 http://oamilvus:19530；Zilliz Cloud 例：https://xxx.api.gcp-us-west1.zillizcloud.com:443）
AGENT_MILVUS_URI=
# Milvus 认证 token（可选；开启认证或使用 Zilliz Cloud 时填写）
AGENT_MILVUS_TOKEN=
# 向量集合名，默认 oa_knowledge_chunks（首次入库时自动创建）
AGENT_MILVUS_COLLECTION=

# Agent 工具调用（请假/审批等业务查询）
AGENT_TOOLS_ENABLED=
AGENT_TOOL_MAX_RESULTS=
